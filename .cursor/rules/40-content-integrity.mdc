description: Protects truthfulness and consistency of portfolio content and personal claims.
globs:
  - "src/app/**/*.tsx"
  - "src/components/**/*.tsx"
  - "src/data/**/*"
  - "src/content/**/*"
  - "README.md"
alwaysApply: false
