rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && request.auth.uid == resource.data.userId;
    }

    function adminDocPath() {
      return /databases/$(database)/documents/siteConfig/admins;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(adminDocPath())
        && request.auth.uid in get(adminDocPath()).data.uids;
    }

    function isValidMessage(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 500;
    }

    function isValidName(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 80;
    }

    function isValidOptionalPhoto() {
      return !('userPhotoURL' in request.resource.data)
        || (
          request.resource.data.userPhotoURL is string
          && request.resource.data.userPhotoURL.size() <= 2048
        );
    }

    function hasRequiredCreateKeys() {
      return request.resource.data.keys().hasAll([
        'name', 'message', 'userId', 'likes', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.keys().hasOnly([
        'name', 'message', 'userId', 'userPhotoURL',
        'likes', 'createdAt', 'updatedAt'
      ]);
    }

    match /siteConfig/admins {
      allow read: if isSignedIn() && request.auth.uid in resource.data.uids;
      allow write: if false;
    }

    match /guestbook/{entryId} {
      allow read: if true;

      allow create: if isSignedIn()
        && hasRequiredCreateKeys()
        && request.resource.data.userId == request.auth.uid
        && isValidName(request.resource.data.name)
        && isValidMessage(request.resource.data.message)
        && request.resource.data.likes is int
        && request.resource.data.likes == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && isValidOptionalPhoto();

      allow update: if isOwner()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['message', 'updatedAt'])
        && isValidMessage(request.resource.data.message)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner() || isAdmin();
    }
  }
}
